# Bekuk — Apache config for this folder (cPanel etc).
# Safe to delete if your host is nginx or something else that ignores it, or if
# your site already forces HTTPS globally (this block is then redundant but
# harmless — Apache applies .htaccess per-directory).

# ------------------------------------------------------------------
# Force HTTPS.
# getUserMedia (the microphone) only works in a secure context. Without this
# redirect, a visitor who lands on the http:// version gets a browser that
# silently hides the microphone API — the app now explains that clearly, but
# forcing HTTPS here means they never hit it in the first place.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------
# One canonical host: bekuk.ir.
#
# bkuk.ir is the short domain, and it earns its keep on share links — those
# carry the whole tuning as base64 in the fragment and are long enough that
# four saved characters show. But the app must never be SERVED from both: the
# same content on two hosts is duplicate content, and whatever ranking it earns
# is split between them.
#
# A 301 costs the share links nothing. The fragment never reaches the server,
# so the browser reattaches it to the new URL by itself: bkuk.ir/#share=… lands
# on bekuk.ir/#share=… intact.
#
# The alternates are named explicitly rather than "anything that is not
# bekuk.ir" — a catch-all would also redirect a staging host or a bare IP, and
# then nothing but production could ever be opened.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?bkuk\.ir$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.bekuk\.ir$ [NC]
  RewriteRule ^ https://bekuk.ir%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------
# Correct MIME types (some hosts serve these wrong by default, which breaks
# module scripts and the local font).
# ------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# ------------------------------------------------------------------
# Compression.
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# ------------------------------------------------------------------
# Caching.
# Everything in assets/ is content-hashed by the build (e.g. index-ih5okNeL.js)
# — a new deploy gets new filenames, so these can be cached forever. index.html
# is the one file that must always be re-checked, or visitors would keep
# loading an old build after an update.
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# No SPA rewrite rules needed: every screen in the app is a URL fragment
# (bekuk.ir/#quick, bekuk.ir/#metronome, ...), and fragments never
# reach the server — index.html is the only page that ever gets requested.
# The tuning-share links (#share=...) work the same way.
